# =============================================================================
# TickShift AI Discord Bot - Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in the real values.
#   cp .env.example .env
# NEVER commit your real `.env` file to version control.
# =============================================================================

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token

# Anthropic Claude API key (from https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/tickshift_db

# Base URL used internally for prop firm validation (do not expose to users)
PROPFIRMMATCH_BASE_URL=https://propfirmmatch.com/

# -----------------------------------------------------------------------------
# Optional tuning (sensible defaults are applied if omitted)
# -----------------------------------------------------------------------------

# Claude model to use for answering questions
ANTHROPIC_MODEL=claude-sonnet-5

# Maximum tokens Claude may generate per response
ANTHROPIC_MAX_TOKENS=1024

# Command prefix for the Discord bot
COMMAND_PREFIX=!

# Minimum seconds between outbound scraping requests (polite rate limiting)
SCRAPE_MIN_INTERVAL=2.0

# Number of days before a cached firm search is considered stale and refreshed
SEARCH_REFRESH_DAYS=30

# Seed the curated TickShift firm catalogue (firms + promo codes) on startup.
# Set to false once your database is populated if you prefer not to re-seed.
SEED_ON_STARTUP=true

# Cache Claude answers so repeat questions don't re-hit the API (saves credits).
# Cached answers are automatically invalidated when firm/promo data changes.
QA_CACHE_ENABLED=true

# Optional maximum age (in days) for a cached answer. 0 = no time limit
# (answers are only invalidated when the underlying data changes).
QA_CACHE_TTL_DAYS=0

# Semantic (meaning-based) caching: match differently-worded questions that
# mean the same thing. Requires a Voyage AI API key (https://voyageai.com/).
# If VOYAGE_API_KEY is omitted, the bot falls back to exact-match caching.
SEMANTIC_CACHE_ENABLED=true
VOYAGE_API_KEY=your_voyage_api_key
VOYAGE_MODEL=voyage-3.5

# Cosine-similarity threshold (0-1) for treating two questions as equivalent.
# Higher = stricter (fewer, safer matches); lower = looser (more matches).
SEMANTIC_CACHE_THRESHOLD=0.85

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Path to the log file
LOG_FILE=logs/bot.log
